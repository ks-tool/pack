{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:pack:platform:horchestra",
  "type": "object",
  "properties": {
    "replicas": {
      "type": "integer",
      "minimum": 0,
      "default": 1
    },
    "placement": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "nodeSelector": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "queue": {
          "type": "string"
        },
        "priority": {
          "type": "integer"
        },
        "spread": {
          "type": "string",
          "enum": [
            "none",
            "host"
          ]
        }
      }
    }
  }
}
